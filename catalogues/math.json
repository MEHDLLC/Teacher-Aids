{
  "version": 1,
  "_comment": "Maths manipulatives. Every set here is derived from a single dimension so its pieces stay comparable -- one unit cube, one shared edge, one whole circle.",
  "release": {
    "name": "teacher-aids-math",
    "version": "0.1.0",
    "title": "Teacher Aids: Maths Manipulatives",
    "summary": "Fraction circles and bars, base-ten place value blocks with a lattice thousand cube, the standard six pattern blocks on a one-inch edge, geometric solids as blocks or as countable open frames, ten frames with counters, and a teaching clock whose hands turn on a printed post."
  },
  "items": [
