      "options": {
        "style": "circle",
        "denominators": "1,2,3,4,5,6,8,10,12",
        "size": 140,
        "max_pieces": 60
      },
      "_comment": "1..12 is 51 pieces; max_pieces is raised to let the whole set through in one run"
